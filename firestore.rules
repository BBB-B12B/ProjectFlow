rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // 1. Rules for Customers
    match /customers/{customerId} {
      allow read, write: if true; 
    }

    // 2. Rules for Projects
    match /projects/{projectId} {
      allow read, write: if true; 
    }

    // 3. Rules for Tasks
    match /tasks/{taskId} {
      allow read, write: if true; 
    }

    // 4. Rules for Tracking
    match /projectTrackingProgress/{document=**} {
      allow read, write: if true; 
    }
    
    // 5. Rules for Calendar Events
    match /events/{eventId} {
      allow read, write: if true;
    }

    // 6. Rules for Presence (Real-time features)
    match /presence/{document=**} {
      allow read, write: if true;
    }

    // 6. Default Deny Class (ปิดท้ายเสมอ)
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
